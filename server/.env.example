# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/crop-recommendation

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ML Microservice
ML_SERVICE_URL=http://localhost:5000

# data.gov.in API (AGMARKNET Crop Market Rates)
DATA_GOV_API_KEY=your_data_gov_in_api_key
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_BASE_URL=https://api.data.gov.in/resource

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:4200

# Email / SMTP Settings (Optional for Password Reset)
# If left blank, password reset links will be printed to the server console for easy testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_EMAIL=noreply@agrosmart.com
FROM_NAME=AgroSmart Support

